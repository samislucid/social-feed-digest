# Copy to .env on the VPS (chmod 600), fill in real values. Never commit .env.
# The worker reads these from the environment; nothing secret lives in the repo.

# --- xAI (X trends + web/news sweep) ----------------------------------------
# https://console.x.ai -> API keys. Live Search tool calls cost $5/1k calls.
XAI_API_KEY=
XAI_MODEL=grok-4.6
XAI_BASE_URL=https://api.x.ai/v1

# --- Private digest page (server) -------------------------------------------
# Generate with: openssl rand -hex 24
DIGEST_PAGE_TOKEN=

# --- Email delivery (Resend primary) ----------------------------------------
# Resend SMTP bridge: smtp.resend.com:587, username "resend",
# password = the Resend API key below (verified against resend.com/docs).
# Without a verified sending domain, Resend only delivers to the account
# owner's own address and From must be onboarding@resend.dev.
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
RESEND_API_KEY_HERMES_SOCIAL=
SMTP_FROM=onboarding@resend.dev
# Generic SMTP password override for non-Resend transports (optional)
SMTP_PASSWORD=
# Optional recipient override; empty = use profile.yaml delivery.email_to
# (samislucid98@gmail.com, the Resend account owner address - the only inbox
# reachable without a verified sending domain, so no domain verification is
# ever needed for this digest).
DIGEST_EMAIL_TO=

# --- Data location (digests, pages, state, watched LinkedIn inbox) -----------
DIGEST_DATA_DIR=data

# --- X API v2 (optional; followed-account ranking boost) --------------------
# OAuth 1.0a user context for Owned Reads (GET /2/users/{id}/following,
# $0.001 per account per docs.x.com pricing). Without these the worker behaves
# exactly as before. Needs the optional extra: pip install -e '.[xapi]'.
X_API_OAUTH1_CONSUMER_KEY=
X_API_OAUTH1_CONSUMER_SECRET=
X_API_ACCESS_TOKEN=
X_API_ACCESS_TOKEN_SECRET=
X_API_USER_ID=
# Optional API base override (tests/mocks). Default: https://api.x.com
#X_API_BASE_URL=

# --- Reddit Data API (optional; RSS fallback works without it) ---------------
# Fill once Sam's app registration is approved. PRAW must be installed.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=social-feed-digest/0.1 (personal digest)
